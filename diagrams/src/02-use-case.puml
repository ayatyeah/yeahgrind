@startuml 02-use-case
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
title YeahGrind — Use Case Diagram

actor "Student" as S
actor "Study-group member" as M
actor "Moderator" as MOD
actor "Microsoft Entra ID" as E <<external>>
actor "Moodle LMS" as L <<external>>
actor "LLM provider" as AI <<external>>
actor "TTS provider" as TTS <<external>>
actor "Scheduler" as T <<system>>
M -up-|> S

rectangle "YeahGrind" {
  package "Accounts & privacy" {
    usecase "UC1 Sign up / sign in" as UC1
    usecase "UC2 Manage consent,\nexport or delete data" as UC2
  }
  package "Goals & content" {
    usecase "UC3 Set goal or subject,\ntime budget" as UC3
    usecase "UC4 Add own material" as UC4
    usecase "UC5 Build skill map\nand micro-units" as UC5
  }
  package "Pathway" {
    usecase "UC6 Take placement test" as UC6
    usecase "UC7 Daily check-in and\ntoday's micro-plan" as UC7
    usecase "UC8 Connect LMS deadlines" as UC8
    usecase "UC9 Review spaced repetition" as UC9
  }
  package "Micro-unit & video" {
    usecase "UC10 Study micro-unit" as UC10
    usecase "UC11 Watch generated\nshort video" as UC11
    usecase "UC12 Generate video" as UC12
  }
  package "Assessment" {
    usecase "UC13 Take adaptive quiz" as UC13
    usecase "UC14 Get hint / feedback" as UC14
    usecase "UC15 View mastery report" as UC15
  }
  package "Social" {
    usecase "UC16 Add friends,\nview feed" as UC16
    usecase "UC17 Share unit or video,\ncomment" as UC17
    usecase "UC18 Study group &\ncooperative challenge" as UC18
    usecase "UC19 Report content" as UC19
  }
  package "Moderation" {
    usecase "UC20 Review queue:\nhide / verify / reject" as UC20
  }
}

S -- UC1
S -- UC2
S -- UC3
S -- UC4
S -- UC6
S -- UC7
S -- UC8
S -- UC10
S -- UC13
S -- UC15
S -- UC16
S -- UC17
S -- UC19
M -- UC18
MOD -- UC20

UC3 ..> UC5 : <<include>>
UC4 ..> UC5 : <<extend>>
UC10 ..> UC11 : <<include>>
UC11 ..> UC12 : <<include>>
UC13 ..> UC14 : <<include>>
UC9 ..> UC13 : <<include>>

UC1 -- E
UC8 -- L
UC5 -- AI
UC12 -- AI
UC12 -- TTS
UC14 -- AI
UC9 -- T
UC8 -- T
@enduml
