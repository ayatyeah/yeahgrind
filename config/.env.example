# Copy to .env.local for development. Placeholder values only — never commit real secrets.

# Application
APP_URL=http://localhost:3000
NODE_ENV=development
TZ_DEFAULT=Asia/Almaty

# Database (data, job rows, narration audio)
DATABASE_URL=postgresql://yeahgrind:change-me@localhost:5432/yeahgrind_dev

# Authentication
AUTH_SECRET=replace-with-32-random-bytes-base64
AUTH_MICROSOFT_ENTRA_ID_ID=00000000-0000-0000-0000-000000000000
AUTH_MICROSOFT_ENTRA_ID_SECRET=replace-me
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# AI gateway — LLM
LLM_PROVIDER=openai
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-model-id
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_API_KEY=
LLM_DAILY_GLOBAL_LIMIT=2000

# AI gateway — text-to-speech (Gemini TTS; Azure AI Speech is the planned alternative)
GOOGLE_GEMINI_API_SECRET=replace-me
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
VIDEO_KK=0

# Scheduled workflows (GitHub Actions) call protected endpoints with this secret
CRON_SECRET=replace-me

# Video pipeline limits
VIDEO_MAX_PER_USER_PER_DAY=10
VIDEO_MAX_RETRIES=3

# LMS integration (AES-256-GCM key for stored iCalendar URLs)
LMS_URL_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Web push (VAPID)
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:team@example.invalid

